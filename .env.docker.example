# Kopiuj jako .env.docker w głównym katalogu projektu.
# Nie dodawaj tego pliku z prawdziwymi hasłami do Gita.
WEB_PORT=8093
ALLOWED_ORIGINS=https://twojstronnik.pl,https://www.twojstronnik.pl

# Bez SMTP serwer kontaktowy pozostanie dostępny, ale formularz zwróci 503.
# Na produkcji ustaw SMTP_REQUIRED=true i uzupełnij dane pocztowe.
SMTP_REQUIRED=false
SMTP_HOST=outsider.mikr.us
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kontakt@twojstronnik.pl
SMTP_PASSWORD=TU_WPISZ_HASLO_SKRZYNKI
SMTP_FROM=kontakt@twojstronnik.pl
SMTP_TO=kontakt@twojstronnik.pl
