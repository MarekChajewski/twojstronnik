# Skopiuj ten plik do .env.docker na VPS. NIGDY nie umieszczaj hasła w repozytorium.
# Upewnij się, że ten port jest wolny na hoście (inne sklepy korzystają z innych portów).
WEB_PORT=8093

# Dozwolone domeny formularza — podaj konkretną domenę HTTPS.
ALLOWED_ORIGINS=https://twojstronnik.pl

# Dane skrzynki na Outsiderze (skrzynka musi istnieć, przekierowanie nie wystarczy).
SMTP_HOST=outsider.mikr.us
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kontakt@twojstronnik.pl
# Hasło w pojedynczych apostrofach (ważne także, jeśli zawiera $ lub #).
SMTP_PASSWORD='TU_WPISZ_HASLO_SKRZYNKI'
SMTP_FROM=kontakt@twojstronnik.pl
SMTP_TO=kontakt@twojstronnik.pl
