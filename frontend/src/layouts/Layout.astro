---
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  isLanding?: boolean;
  artistTheme?: boolean;
  guideTheme?: boolean;
  legalTheme?: boolean;
  noindex?: boolean;
  showCanonical?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Strony internetowe dla artystów i przewodników | Twój Stronnik',
  description = 'Gotowe strony internetowe dla artystów i przewodników. Galerie online, sklepy z dziełami sztuki, oferta wycieczek i łatwa edycja treści.',
  hideFooter = false,
  isLanding = false,
  artistTheme = false,
  guideTheme = false,
  legalTheme = false,
  noindex = false,
  showCanonical = true,
  structuredData,
} = Astro.props;

// Adres produkcyjny jest ustawiony w astro.config.mjs — localhost nigdy nie trafia do canonical.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://twojstronnik.pl');
const shareImage = new URL('/logo-ts.png', canonical).toString();
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {showCanonical && <link rel="canonical" href={canonical.toString()} />}
    <meta name="theme-color" content={isLanding ? '#f1f0ea' : legalTheme ? '#fbfaf6' : artistTheme ? '#f7f3eb' : guideTheme ? '#183d33' : '#070a12'} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Twój Stronnik" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="677" />
    <meta property="og:image:height" content="677" />
    <meta property="og:image:alt" content="Logotyp Twój Stronnik" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class={isLanding ? 'home-landing' : artistTheme ? 'artist-theme' : guideTheme ? 'guide-theme' : legalTheme ? 'legal-theme' : undefined}>
    <Navigation />
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
