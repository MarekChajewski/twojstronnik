---
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

type Theme = 'landing' | 'artist' | 'guide' | 'legal';

interface Props {
  title?: string;
  description?: string;
  theme?: Theme;
  hideFooter?: boolean;
  noindex?: boolean;
}

const {
  title = 'Twój Stronnik — strony dla artystów i przewodników',
  description = 'Gotowe strony internetowe dla artystów i przewodników. Galerie, portfolio, oferty wycieczek, cenniki i kontakt.',
  theme = 'legal',
  hideFooter = false,
  noindex = false,
} = Astro.props;

const themeClasses: Record<Theme, string> = {
  landing: 'home-landing',
  artist: 'artist-theme',
  guide: 'guide-theme',
  legal: 'legal-theme',
};
const themeColors: Record<Theme, string> = {
  landing: '#f1f0ea',
  artist: '#f7f3eb',
  guide: '#183d33',
  legal: '#fbfaf6',
};
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Twój Stronnik" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/logo-ts.png', Astro.site ?? Astro.url.origin).href} />
    <meta name="theme-color" content={themeColors[theme]} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body class={themeClasses[theme]}>
    <Navigation theme={theme} />
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <script>
      import { initPressFeedback } from '../scripts/pressFeedback';
      initPressFeedback();
    </script>
  </body>
</html>
