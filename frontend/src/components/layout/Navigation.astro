---
interface Props {
  theme: 'landing' | 'artist' | 'guide' | 'legal';
}

const { theme } = Astro.props;

const links = theme === 'landing'
  ? [
      { label: 'Dla artystów', href: '/dla-artystow/' },
      { label: 'Dla przewodników', href: '/dla-przewodnikow/' },
    ]
  : theme === 'legal'
    ? [
        { label: 'Start', href: '/' },
        { label: 'Dla artystów', href: '/dla-artystow/' },
        { label: 'Dla przewodników', href: '/dla-przewodnikow/' },
        { label: 'Kontakt', href: 'mailto:kontakt@twojstronnik.pl' },
      ]
    : [
        { label: 'Start', href: '/' },
        { label: 'Dla artystów', href: '/dla-artystow/' },
        { label: 'Dla przewodników', href: '/dla-przewodnikow/' },
        { label: 'Realizacje', href: '#realizacje' },
        { label: 'Jak to działa', href: '#jak-to-dziala' },
        { label: 'Kontakt', href: '#kontakt' },
      ];
---
<nav class="nav" data-site-nav aria-label="Główna nawigacja">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Twój Stronnik — strona główna">
      <img src="/logo-ts.png" class="brand-logo" alt="" width="44" height="44" />
      <span class="brand-copy"><strong>Twój Stronnik</strong></span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Otwórz menu"
      aria-controls="primary-navigation"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
    </button>

    <ul id="primary-navigation" class="nav-links">
      {links.map(({ label, href }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  import { initNavigation } from '../../scripts/navigation';
  initNavigation();
</script>
