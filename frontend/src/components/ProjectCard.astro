---
import type { Project } from '../types/content';

interface Props extends Project {}

const { title, href, eyebrow, logo, logoAlt } = Astro.props;
---
<article class="project-card" data-pressable>
  <div class="project-content">
    <span class="project-eyebrow">{eyebrow}</span>
    <h3>{title}</h3>
    <a class="project-link" data-pressable href={href} target="_blank" rel="noopener noreferrer">
      Zobacz realizację
    </a>
  </div>
  <div class="project-logo">
    <div class="project-logo-frame">
      <img src={logo} alt={logoAlt} width="800" height="620" loading="lazy" decoding="async" />
    </div>
  </div>
</article>
