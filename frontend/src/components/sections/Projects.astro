---
import ProjectCard from '../ProjectCard.astro';
import type { Project } from '../../types/content';

interface Props {
  title: string;
  intro: string;
  projects: Project[];
}

const { title, intro, projects } = Astro.props;
---
<section class="my-projects" id="realizacje">
  <div class="container">
    <span class="eyebrow">Realizacje</span>
    <h2>{title}</h2>
    <p>{intro}</p>
    <div class:list={['projects-grid', { 'projects-grid--single': projects.length === 1 }]}>
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </div>
</section>
