---
import type { Feature } from '../../types/content';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: Feature[];
}

const { eyebrow, title, intro, items } = Astro.props;
---
<section class="about">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
    <p>{intro}</p>
    <div class="about-grid">
      {items.map(({ title, text }) => (
        <article class="about-item" data-pressable>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
