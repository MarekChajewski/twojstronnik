---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  theme: 'artist' | 'guide';
}

const { eyebrow, title, text, primaryLabel, primaryHref, secondaryLabel, secondaryHref, theme } = Astro.props;
---
<section class={`hero hero-${theme}`}>
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{text}</p>
    <div class="hero-actions">
      <a class="button button-primary" data-pressable href={primaryHref}>{primaryLabel}</a>
      <a class="button button-secondary" data-pressable href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
  {theme === 'guide' && (
    <div class="guide-hero-art" aria-hidden="true">
      <img src="/guide-mountains.svg" alt="" width="1050" height="760" decoding="async" />
    </div>
  )}
</section>
